FROM node:24.18.1-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7 AS production-dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && rm -rf node_modules/next && test ! -d node_modules/next

FROM node:24.18.1-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY src ./src
COPY contracts ./contracts
COPY scripts/verify-exomem-gateway-bundle.mjs ./scripts/verify-exomem-gateway-bundle.mjs
COPY tsconfig.json ./
RUN npm run gateway:build

FROM node:24.18.1-bookworm-slim@sha256:235600a8101ab264e117b1768e925532262668dc9b581ef1dd7d96ced463b8e7
WORKDIR /app
COPY --from=production-dependencies --chown=1000:1000 /app/node_modules ./node_modules
COPY --from=build --chown=1000:1000 /app/dist/exomem-gateway/index.cjs ./gateway/index.cjs
EXPOSE 8080
ENV EXOMEM_GATEWAY_PORT=8080
USER 1000:1000
CMD ["node", "gateway/index.cjs"]
