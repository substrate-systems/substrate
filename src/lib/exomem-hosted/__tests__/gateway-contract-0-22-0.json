{
  "schema_version": 1,
  "protocol_version": "1",
  "exomem_release": "0.22.0",
  "compatibility": {
    "policy": "additive",
    "optional_response_fields_may_be_added": true,
    "breaking_changes_require_coordinated_rollout": true,
    "breaking_change_classes": [
      "command-removal",
      "parameter-removal-or-change",
      "envelope-change",
      "stable-error-removal-or-change"
    ]
  },
  "trusted_headers": {
    "cell": "X-Exomem-Cell-Id",
    "protocol": "X-Exomem-Protocol-Version",
    "request": "X-Exomem-Request-Id",
    "principal": "X-Exomem-Principal-Scope",
    "idempotency": "Idempotency-Key"
  },
  "envelopes": {
    "success": {
      "required": ["success", "data"],
      "shape": {
        "success": true,
        "data": "command-result"
      }
    },
    "error": {
      "required": ["success", "error"],
      "error_required": ["code", "message", "remediation"],
      "shape": {
        "success": false,
        "error": {
          "code": "stable-code",
          "message": "content-free-message",
          "remediation": null
        }
      }
    }
  },
  "transfer_grant": {
    "version": 1,
    "audience": "exomem-hosted-transfer",
    "operations": ["download", "upload"],
    "max_ttl_seconds": 900
  },
