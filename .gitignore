# Dependencies
node_modules

# Next.js
.next/
out/

# Production
build/

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*

# Local env files
.env*.local

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Prettier
.prettierignore

# IDE
.idea
.vscode

# Sandbox artifacts (bare-repo internals that appear at repo root)
/HEAD
/config
/hooks
/objects
/refs

# Loose home-dir dotfiles bind-mounted at repo root (sandbox artifact)
/.bash_profile
/.bashrc
/.profile
/.zprofile
/.zshrc
/.gitconfig
/.gitmodules
/.mcp.json
/.ripgreprc

# Playwright MCP scratch output
.playwright-mcp/

# Claude Code: per-user local overrides (shared config is committed)
.claude/settings.local.json
.vercel

# Design iteration scratch — local-only mockups, screenshots, render scripts
.design/
.vis-*
.claim-page-*.png
.endstate-pricing-*.png

# Local implementation/drill briefs and disposable provider fixtures
.task/

# OMC (oh-my-claudecode) runtime state — session HUD caches, throttles, agent
# replay logs. Regenerated every session, so tracking them means a permanently
# dirty tree and merge collisions on pull. Matches at any depth: these dirs also
# appear under .claude/skills/*/ when a skill is authored from a session cwd.
# .omc/skills/ is the documented exception — project-scoped skills are committable.
**/.omc/*
!**/.omc/skills/

# Playwright end-to-end run output
/test-results/
/playwright-report/
/blob-report/
